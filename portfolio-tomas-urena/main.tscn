theme_override_styles/normal = SubResource("StyleBoxFlat_1bvp3")
text = "     Hello, my name is Tomas Urena. I am a recent New Mexico State University graduate. I graduated with a Bachelor of Science in Computer Science with a focus in Artificial Intelligence. I am currently studying for my Master’s degree. I plan to get a Master’s of Science in Computer Science. I am an inspiring creator(someone who makes things). As much as technology has been in my life, so has my desire to create an experience. I plan to get a job that can allow me to have time on my personal projects. I solve each problem as if it's the only problem I’m facing."
horizontal_alignment = 3
metadata/_edit_lock_ = true

